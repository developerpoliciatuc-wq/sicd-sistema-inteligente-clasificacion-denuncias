    import sys&#xd;
    import os&#xd;
    &#xd;
    # Agregar ruta del proyecto al path&#xd;
    ruta_proyecto = QgsProject.instance().homePath()&#xd;
    if ruta_proyecto not in sys.path:&#xd;
        sys.path.append(ruta_proyecto)&#xd;
    &#xd;
    print("[SICD] Proyecto cargado. Ejecute el script auto_refresh_sicd.py en la consola de Python.")&#xd;
&#xd;
def saveProject():&#xd;
    """Código ejecutado al guardar el proyecto."""&#xd;
    pass&#xd;
&#xd;
def closeProject():&#xd;
    """Código ejecutado al cerrar el proyecto."""&#xd;
    print("[SICD] Proyecto cerrado.")&#xd;
