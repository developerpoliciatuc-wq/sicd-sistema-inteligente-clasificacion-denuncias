<?xml version="1.0" encoding="UTF-8"?>
<qgis projectname="SICD - Sistema Inteligente de Clasificación de Denuncias" version="2.14.14-Essen">
  <title>SICD - Mapa de Denuncias Tucumán</title>
  <layer-tree-group expanded="1" checked="Qt::Checked" name="">
    <customproperties/>
    <layer-tree-group expanded="1" checked="Qt::Checked" name="Denuncias SICD">
      <customproperties/>
    </layer-tree-group>
    <layer-tree-group expanded="1" checked="Qt::Checked" name="Jurisdicciones">
      <customproperties/>
    </layer-tree-group>
  </layer-tree-group>
  <relations/>
  <mapcanvas>
    <units>degrees</units>
    <extent>
      <xmin>-66.5</xmin>
      <ymin>-28.0</ymin>
      <xmax>-64.5</xmax>
      <ymax>-26.0</ymax>
    </extent>
    <rotation>0</rotation>
    <projections>0</projections>
    <destinationsrs>
      <spatialrefsys>
        <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
        <srsid>3452</srsid>
        <srid>4326</srid>
        <authid>EPSG:4326</authid>
        <description>WGS 84</description>
        <projectionacronym>longlat</projectionacronym>
        <ellipsoidacronym>WGS84</ellipsoidacronym>
        <geographicflag>true</geographicflag>
      </spatialrefsys>
    </destinationsrs>
    <layer_coordinate_transform_info/>
  </mapcanvas>
  <legend updateDrawingOrder="true">
    <legendgroup open="true" checked="Qt::Checked" name="Denuncias SICD"/>
    <legendgroup open="true" checked="Qt::Checked" name="Jurisdicciones"/>
  </legend>
  <Gui>
    <CanvasColorRedPart>255</CanvasColorRedPart>
    <CanvasColorGreenPart>255</CanvasColorGreenPart>
    <CanvasColorBluePart>255</CanvasColorBluePart>
    <SelectionColorRedPart>255</SelectionColorRedPart>
    <SelectionColorGreenPart>255</SelectionColorGreenPart>
    <SelectionColorBluePart>0</SelectionColorBluePart>
    <SelectionColorAlphaPart>255</SelectionColorAlphaPart>
  </Gui>
  <visibility-presets/>
  <projectlayers layercount="0"/>
  <properties>
    <WMSServiceTitle type="QString">SICD - Mapa de Denuncias</WMSServiceTitle>
    <WMSServiceAbstract type="QString">Sistema Inteligente de Clasificación de Denuncias - Policía de Tucumán</WMSServiceAbstract>
    <WMSContactPerson type="QString"></WMSContactPerson>
    <WMSContactOrganization type="QString">Policía de Tucumán</WMSContactOrganization>
    <WMSOnlineResource type="QString"></WMSOnlineResource>
    <WMSContactMail type="QString"></WMSContactMail>
    <Paths>
      <Absolute type="bool">false</Absolute>
    </Paths>
    <Macros>
      <pythonCode type="QString">
# Script de inicialización del proyecto SICD
# Se ejecuta automáticamente al abrir el proyecto

def openProject():
    """Código ejecutado al abrir el proyecto."""
    # Importar el script de monitoreo
    import sys
    import os
    
    # Agregar ruta del proyecto al path
    ruta_proyecto = QgsProject.instance().homePath()
    if ruta_proyecto not in sys.path:
        sys.path.append(ruta_proyecto)
    
    print("[SICD] Proyecto cargado. Ejecute el script auto_refresh_sicd.py en la consola de Python.")

def saveProject():
    """Código ejecutado al guardar el proyecto."""
    pass

def closeProject():
    """Código ejecutado al cerrar el proyecto."""
    print("[SICD] Proyecto cerrado.")
      </pythonCode>
    </Macros>
  </properties>
</qgis>
