# --- IA (Google AI Studio / Gemini API) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OCR ---
# Windows example:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# Poppler (only needed for pdf2image)
# POPPLER_PATH=C:/Program Files/poppler/Library/bin
POPPLER_PATH=

# --- Rutas ---
# Ruta raiz destino (UNC recomendado)
DEST_ROOT=\\\\ANALISIS-3\\Analisis-3\\MAPA DEL DELITO
REVISION_ROOT=\\\\ANALISIS-3\\Analisis-3\\MAPA DEL DELITO\\_REVISION_MANUAL

# --- Matching ---
FUZZY_THRESHOLD=85

# --- Estadisticas ---
STATS_XLSX=Base_Estadistica_2025.xlsx

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/scid.log
